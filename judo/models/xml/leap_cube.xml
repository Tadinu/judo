<mujoco model="leap_rh">
    <include file="leap_components/assets.xml"/>
    <include file="leap_components/params_and_default.xml"/>

    <worldbody>
        <body name="target" pos="-0.1 -0.1 0.3" quat="1 0 0 0" mocap="true">
            <include file="leap_components/cube_pips_vis.xml"/>
        </body>
        <body name="cube" pos="0.0 0.0 0.2" quat="1 0 0 0">
            <freejoint name="cube_freejoint"/>
            <include file="leap_components/cube_pips_coll.xml"/>
        </body>
        <body name="leap_hand" pos="0.0 0.0 0.0" quat="0 0.9961947 0 -0.0871557">
            <include file="leap_components/leap_hand.xml"/>
        </body>
    </worldbody>

    <sensor>
        <!-- cube -->
        <framepos name="cube_position" objtype="body" objname="cube"/>
        <framepos name="cube_distance_to_grasp" objtype="body" objname="cube" reftype="site" refname="grasp_site"/>
        <framepos name="cube_distance_from_target" objtype="body" objname="cube" reftype="body" refname="target"/>
        <framequat name="cube_orientation" objtype="body" objname="cube"/>
        <framequat name="cube_orientation_from_target" objtype="body" objname="cube" reftype="body" refname="target"/>
        <contact name="cube_contact_with_palm" geom1="cube" geom2="palm_visual" data="found force"/>
    </sensor>
</mujoco>
