<mujoco model="leap_rh_fabric_mug_sim">
  <include file="leap_rh_fabric_freejoint.xml"/>
  <include file="objects/mug/mug.xml"/>

  <statistic center="0.15 0 0" extent="0.4" meansize="0.01"/>
  <size nuserdata="1"/>

  <visual>
    <headlight diffuse=".8 .8 .8" ambient=".2 .2 .2" specular="1 1 1"/>
    <rgba force="1 0 0 1"/>
    <global azimuth="120" elevation="-20"/>
    <map force="0.01" stiffness="500"/>
    <scale forcewidth="0.1" contactwidth="0.5" contactheight="0.2"/>
    <quality shadowsize="8192"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="1 1 1" rgb2="1 1 1" width="800" height="800"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="1 1 1" rgb2="1 1 1" markrgb="0 0 0"
             width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0"/>
  </asset>

  <worldbody>
    <camera name="side" pos="-0.183 0.396 0.296" xyaxes="-0.783 -0.622 -0.000 0.332 -0.419 0.845"/>
    <geom name="floor" pos="0 0 0" size="0 0 0.01" type="plane" material="groundplane" contype="1" conaffinity="1"/>
    <body name="target" mocap="true" pos="0.325 0.17 0.4">
      <geom type="mesh" mesh="mug" contype="0" conaffinity="0" group="2"/>
    </body>
  </worldbody>

  <sensor>
    <!-- mug. -->
    <framepos name="mug_position" objtype="body" objname="mug"/>
    <contact name="mug_contact_with_palm" geom1="mug" geom2="palm_visual" data="found force"/>
    <contact name="mug_contact_with_th_tip" geom1="mug" geom2="th_tip" data="found force"/>
    <contact name="mug_contact_with_if_tip" geom1="mug" geom2="if_tip" data="found force"/>
    <contact name="mug_contact_with_mf_tip" geom1="mug" geom2="mf_tip" data="found force"/>
    <contact name="mug_contact_with_rf_tip" geom1="mug" geom2="rf_tip" data="found force"/>
    <framepos name="mug_distance_to_grasp" objtype="site" objname="mug_handle_center" reftype="site"
              refname="grasp_site"/>
    <framepos name="mug_distance_to_target" objtype="body" objname="mug" reftype="body" refname="target"/>
    <framequat name="mug_orientation" objtype="body" objname="mug"/>
    <framequat name="mug_orientation_from_target" objtype="body" objname="mug" reftype="body" refname="target"/>
    <framepos name="grasp_distance_from_target" objtype="site" objname="grasp_site" reftype="body" refname="target"/>
    <framelinvel name="mug_linear_vel" objtype="body" objname="mug"/>
    <frameangvel name="mug_angular_vel" objtype="body" objname="mug"/>
    <frameangacc name="mug_angular_acc" objtype="body" objname="mug"/>
    <framezaxis name="mug_upvector" objtype="body" objname="mug"/>

    <!-- hand. -->
    <framepos name="palm_position" objtype="site" objname="grasp_site"/>
    <framepos name="th_tip_distance_to_mug" objtype="site" objname="th_tip" reftype="body" refname="mug"/>
    <framepos name="if_tip_distance_to_mug" objtype="site" objname="if_tip" reftype="body" refname="mug"/>
    <framepos name="mf_tip_distance_to_mug" objtype="site" objname="mf_tip" reftype="body" refname="mug"/>
    <framepos name="rf_tip_distance_to_mug" objtype="site" objname="rf_tip" reftype="body" refname="mug"/>

    <!-- goal. -->
    <framequat name="mug_goal_orientation" objtype="body" objname="target"/>
    <framezaxis name="mug_goal_upvector" objtype="body" objname="target"/>
  </sensor>

